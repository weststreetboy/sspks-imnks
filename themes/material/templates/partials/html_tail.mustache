                </div>
            </main>
                <footer class="dcf" data-dcf>
                    <svg class="dcf__defs" aria-hidden="true" focusable="false" width="0" height="0">
                        <defs>
                            <filter id="dcf-rough" x="-8%" y="-12%" width="116%" height="124%">
                                <feTurbulence type="fractalNoise" baseFrequency="0.016 0.028" numOctaves="3" seed="7" result="dcf-noise"></feTurbulence>
                                <feDisplacementMap in="SourceGraphic" in2="dcf-noise" scale="3.6" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
                            </filter>
                        </defs>
                    </svg>
                    <div class="dcf__inner">
                        <div class="dcf__top">
                            <div class="dcf__brand">
                                <a class="dcf__brand-name" href="{{ baseUrlRelative }}">{{ siteName }}</a>
                                <p class="dcf__blurb">{{ footer_based_on }}</p>
                            </div>
                            <div class="dcf__columns">
{{# footerColumns }}
                                <section class="dcf__column">
                                    <h2>{{ title }}</h2>
{{# links }}
                                    <a href="{{ url }}" target="_blank" rel="noopener noreferrer"><span>{{ label }}</span></a>
{{/ links }}
                                </section>
{{/ footerColumns }}
                            </div>
                        </div>

                        <div class="dcf__stage">
                            <span class="dcf__doodle dcf__doodle--1" aria-hidden="true">
                                <svg viewBox="-16 -16 32 32"><path fill="#ff7a1a" d="M0 14 C-9 14 -12 6 -10 0 C-8 -5 -4 -6 -4 -12 C1 -9 3 -5 2 -1 C4 -3 5 -6 5 -8 C10 -3 11 4 8 9 C6 12 3 14 0 14 Z"></path><path fill="#ffd23f" d="M0 11.5 C-4 11.5 -6 8 -5 5 C-4 2 -1 1 -1 -3 C2 -1 4 3 3 6 C4 5 5 4 5 3 C7 6 5 11.5 0 11.5 Z"></path></svg>
                            </span>
                            <span class="dcf__doodle dcf__doodle--2" aria-hidden="true">
                                <svg viewBox="-16 -16 32 32"><path fill="#ffd23f" d="M0 -13 L3.6 -4.4 L13 -4 L5.8 2.2 L8.2 12 L0 6.6 L-8.2 12 L-5.8 2.2 L-13 -4 L-3.6 -4.4 Z"></path></svg>
                            </span>
                            <span class="dcf__doodle dcf__doodle--3" aria-hidden="true">
                                <svg viewBox="-16 -16 32 32"><path fill="#8fdcff" d="M0 -13 C1 -4 4 -1 13 0 C4 1 1 4 0 13 C-1 4 -4 1 -13 0 C-4 -1 -1 -4 0 -13 Z"></path></svg>
                            </span>
                            <span class="dcf__doodle dcf__doodle--4" aria-hidden="true">
                                <svg viewBox="-16 -16 32 32"><path fill="#ff5c7a" d="M0 11 C-6 6 -13 1 -13 -5 C-13 -10 -8 -13 -4 -11 C-2 -10 -1 -8 0 -6 C1 -8 2 -10 4 -11 C8 -13 13 -10 13 -5 C13 1 6 6 0 11 Z"></path></svg>
                            </span>

                            <h2 class="dcf__word" aria-label="{{ siteName }}">
                                <span class="dcf__letter">A</span><span class="dcf__letter">N</span><span class="dcf__letter">G</span><span class="dcf__letter">E</span><span class="dcf__letter">L</span><span class="dcf__letter dcf__letter--space"></span><span class="dcf__letter">S</span><span class="dcf__letter">T</span><span class="dcf__letter">U</span><span class="dcf__letter">D</span><span class="dcf__letter">I</span><span class="dcf__letter">O</span>
                            </h2>

                            <figure class="dcf__crew" aria-hidden="true">
                                <svg viewBox="-30 -58 60 64">
                                    <path class="dcf-ink" d="M-10 -15 L-17 -9 M10 -15 L17 -11"></path>
                                    <path class="dcf-paper" d="M-10 0 C-12 -10 -10 -22 -8 -28 L8 -28 C10 -22 12 -10 10 0 C4 2 -4 2 -10 0 Z"></path>
                                    <path class="dcf-cap" d="M-25 -28 C-27 -45 -12 -55 0 -55 C12 -55 27 -45 25 -28 C14 -23 -14 -23 -25 -28 Z"></path>
                                    <circle class="dcf-spot" cx="-12" cy="-40" r="4.2"></circle>
                                    <circle class="dcf-spot" cx="6" cy="-46" r="3.4"></circle>
                                    <circle class="dcf-spot" cx="15" cy="-34" r="3"></circle>
                                    <path class="dcf-ink" d="M-2 -10 C-1 -8 1 -8 2 -10"></path>
                                    <circle class="dcf-eye" cx="-4.5" cy="-16" r="1.9"></circle>
                                    <circle class="dcf-eye" cx="4.5" cy="-16" r="1.9"></circle>
                                </svg>
                            </figure>

                            <svg class="dcf__ground" viewBox="0 0 1200 14" preserveAspectRatio="none" aria-hidden="true">
                                <path d="M2 7 Q 52 2 102 7 T 202 7 T 302 7 T 402 7 T 502 7 T 602 7 T 702 7 T 802 7 T 902 7 T 1002 7 T 1102 7 T 1198 7"></path>
                            </svg>
                        </div>

                        <p class="dcf__tagline">{{ footer_tagline }}</p>

                        <div class="dcf__actions">
                            <button class="dcf__action dcf__action--outline" type="button" data-copy-source>
                                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="4" width="11" height="14" rx="2.4"></rect><path d="M15.5 18.5v.7A1.8 1.8 0 0 1 13.7 21H5.8A1.8 1.8 0 0 1 4 19.2V8.4A1.8 1.8 0 0 1 5.8 6.6h.7"></path></svg>
                                <span data-copy-label>{{ copy_address }}</span>
                            </button>
{{# updatePageUrl }}
                            <a class="dcf__action dcf__action--solid" href="{{ updatePageUrl }}">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 -2 L2 14 L9 14 L7 26 L18 -2 Z"></path></svg>
                                {{ index_incremental }}
                            </a>
{{/ updatePageUrl }}
                        </div>

                        <div class="dcf__bottom">
                            <div class="dcf__meta">
                                <span class="footer-copyright">© {{ currentYear }} {{ siteName }}</span>
                                <span>Based on <a href="https://github.com/jdel/sspks" target="_blank" rel="noopener noreferrer">jdel/sspks</a></span>
                                <a class="dcf__repo" href="https://github.com/tbc0309/sspks-imnks" target="_blank" rel="noopener noreferrer" aria-label="{{ siteName }}">
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.29-5.27-1.29-5.27-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.16 1.18a10.98 10.98 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.75.11 3.04.74.8 1.19 1.83 1.19 3.08 0 4.4-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.18c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z"></path></svg>
                                    <span>sspks-imnks</span>
                                </a>
                                <a href="https://github.com/tbc0309/sspks-imnks/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">GNU GPL v3</a>
                            </div>
{{# branch }}
                            <span class="footer-version">{{ branch }}{{# commitHash }} · {{ commitHash }}{{/ commitHash }}</span>
{{/ branch }}
                        </div>
                    </div>
                </footer>
                <button class="back-to-top" type="button" title="{{ back_top }}" aria-label="{{ back_top }}" aria-hidden="true" tabindex="-1" hidden data-back-to-top>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 15.5 12 8l7 7.5"/></svg>
                </button>
        </div>
    </body>
</html>
