# 复制成 .env 后填真实值：cp .env.example .env
# .env 已在 .gitignore 里，不会被提交
#
# docker compose 会在本目录自动读取 .env，这里填什么，容器就吃什么。

# ── 基本部署 ────────────────────────────────────────────────
# NAS 上对外暴露的端口（DSM 套件来源地址里必须用同一个）
SSPKS_PORT=13803

# spk / 索引库 / 图标的存放根目录（其下会有 packages、runtime、cache 三个子目录）
SSPKS_DATA_DIR=/volume6/docker/sspks-imnks

SSPKS_TZ=Asia/Shanghai

# ── 站点身份 ────────────────────────────────────────────────
# 必须是 DSM 实际访问的地址，含端口、末尾带 /；改 IP 或端口时这里要同步改
SSPKS_BASE_URL=http://ip:13803/

# 站点标题 / SEO 描述
SSPKS_SITE_NAME=xxx 套件源
SSPKS_SITE_DESCRIPTION=自建 DSM 7 套件源：自己编译的 SPK 也能像官方来源一样管理和升级。

# 默认配色：teal / ocean / violet / dark / aurora（aurora 为深色紫青渐变）
SSPKS_DEFAULT_PALETTE=teal

# ── 包元数据（显示在套件中心详情页）─────────────────────────
SSPKS_PACKAGES_MAINTAINER=名称
SSPKS_PACKAGES_MAINTAINER_URL=http://ip:13803/
SSPKS_PACKAGES_DISTRIBUTOR=名称
SSPKS_PACKAGES_DISTRIBUTOR_URL=http://ip:13803/
SSPKS_PACKAGES_SUPPORT_URL=http://ip:13803/

# ── 索引管理 ────────────────────────────────────────────────
# 索引管理页密码（等价于 conf/database.yaml 的 management_password）
# 建议长度 >= 16 的随机串；网页「更新套件索引」页填的就是这个
SSPKS_UPDATE_TOKEN=change-this-management-password

# 索引刷新入口：?action=<这个值>，建议换成别人猜不到的串
SSPKS_UPDATE_ACTION=change-this-refresh-action

# ── 网页下载 ────────────────────────────────────────────────
# 页面上的「下载 SPK」按钮
SSPKS_BROWSER_DOWNLOAD_ENABLED=true
# 图标 / 下载地址是否走不透明地址（依赖镜像 nginx 的 /_sspks_download/）
SSPKS_BROWSER_OBFUSCATE_IMAGES=true
SSPKS_BROWSER_OBFUSCATE_DOWNLOADS=true

# ── 可选 ────────────────────────────────────────────────────
# 拉不到 ghcr.io 时改成 tar 导入后的镜像名，例如 sspks-imnks:amd64
# SSPKS_IMAGE=ghcr.io/weststreetboy/sspks-imnks:latest
